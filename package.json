{
  "name": "nextjs-sandbox",
  "version": "0.1.0",
  "private": true,
  "description": "Web development laboratory for experimenting with Next.js and related technologies",
  "author": "h-waji (hamltail)",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "email": "email dev --dir components/emails",
    "postinstall": "prisma generate",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "e2e:setup": "tsx --env-file-if-exists=.env.local scripts/e2e-setup.ts",
    "pretest:e2e": "npm run e2e:setup",
    "test:e2e": "playwright test",
    "test": "npm run format:check && npm run lint && npm run typecheck && npm run test:unit && npm run build && npm run test:e2e",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1112.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@react-three/postprocessing": "^3.1.0",
    "bcryptjs": "^3.0.3",
    "microcms-js-sdk": "^3.4.0",
    "next": "^16.3.4",
    "next-intl": "^4.14.2",
    "next-themes": "^0.4.6",
    "pg": "^8.22.0",
    "prisma": "^7.9.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "resend": "^6.20.0",
    "three": "^0.185.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@chromatic-com/storybook": "latest",
    "@playwright/test": "^1.62.1",
    "@react-email/ui": "^6.9.2",
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/addon-docs": "^10.5.10",
    "@storybook/addon-onboarding": "^10.5.10",
    "@storybook/nextjs-vite": "^10.5.10",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/k6": "^2.2.0",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "eslint-plugin-storybook": "^10.5.10",
    "prettier": "^3.9.6",
    "react-email": "^6.9.2",
    "storybook": "^10.5.10",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vite": "latest",
    "vitest": "^4.1.11"
  }
}
